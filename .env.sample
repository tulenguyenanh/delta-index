# OptiBot Mini-Clone — environment sample
#
# Phase 1 (scrape & clean) requires NO secrets: the Zendesk Help Center API on
# support.optisigns.com is anonymous and read-only. Copy this file to `.env`
# only once a later phase needs a value, and never commit real keys.

# Gemini File Search (Phase 2: upload & assistant) — API key from
# https://aistudio.google.com/apikey. Required for live upload/query.
GOOGLE_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_STORE_NAME=fileSearchStores/<id>
# GEMINI_STORE_DISPLAY_NAME=optibot-knowledge-base
