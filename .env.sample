# Copy this file to .env for local runs. Never commit .env or a real key.
#
# Gemini API key from https://aistudio.google.com/apikey. Required for the
# live upload and for answering questions.
GOOGLE_API_KEY=
# The Docker entrypoint also accepts API_KEY (container and CI runs only, e.g.
# `docker run -e API_KEY=<key> ...`, which is how the daily workflow passes it)
# and copies it to GOOGLE_API_KEY. Setting API_KEY only in this local env file
# does NOT work, so set GOOGLE_API_KEY above for local runs.
# API_KEY=
#
# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_STORE_NAME=fileSearchStores/<id>
# GEMINI_STORE_DISPLAY_NAME=optibot-knowledge-base
